# ============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your production values
# NEVER commit .env to version control
# Store secrets in AWS Secrets Manager, HashiCorp Vault, or similar
# ============================================================================

# Application Settings
# ============================================================================
NODE_ENV=production
PORT=4000

# Must use HTTPS in production - set to your production domain
CLIENT_URL=https://yourdomain.com

# ============================================================================
# Database Configuration (MongoDB Atlas)
# ============================================================================
# Format: mongodb+srv://username:password@cluster.mongodb.net/tracker?retryWrites=true&w=majority&ssl=true
# 
# Setup instructions:
# 1. Create MongoDB Atlas cluster at https://www.mongodb.com/cloud/atlas
# 2. Enable encryption at rest (default in paid tier)
# 3. Set IP whitelist to your server IPs only (not 0.0.0.0)
# 4. Enable automated backups
# 5. Copy connection string and replace username:password
MONGODB_URI=mongodb+srv://username:password@your-cluster.mongodb.net/tracker?retryWrites=true&w=majority&ssl=true

# ============================================================================
# Redis Configuration (Redis Cloud or Self-Hosted)
# ============================================================================
# Format: rediss://username:password@redis-host:port (note: rediss:// for TLS)
# 
# Redis Cloud setup:
# 1. Create Redis database at https://redis.com/try-free/
# 2. Enable TLS (default for cloud)
# 3. Configure access control list (IP whitelist)
# 4. Enable persistence (AOF - Append Only File)
# 5. Set eviction policy to 'allkeys-lru'
# 6. Copy connection string
REDIS_URL=rediss://default:password@redis-host:6379

# ============================================================================
# JWT Configuration
# ============================================================================
# Generate secure random strings using:
#   openssl rand -base64 32
# 
# These MUST be at least 32 characters and cryptographically random
# Regenerate if you suspect compromise (will log out all users)
JWT_ACCESS_SECRET=<generate-with-openssl-rand-base64-32>
JWT_REFRESH_SECRET=<generate-with-openssl-rand-base64-32>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=14

# ============================================================================
# Cookie Configuration
# ============================================================================
# COOKIE_SECURE=true is REQUIRED in production (enforced in app.ts)
# If not set to true in production, server will not start
COOKIE_SECURE=true
COOKIE_DOMAIN=.yourdomain.com

# ============================================================================
# Email Configuration (SMTP)
# ============================================================================
# Email service is REQUIRED in production for:
# - Account verification
# - Password reset
# - Email notifications
# 
# Recommended providers:
# - SendGrid: https://sendgrid.com (50/day free)
# - AWS SES: https://aws.amazon.com/ses/
# - Mailgun: https://www.mailgun.com/
# - Postmark: https://postmarkapp.com/
# - Gmail: https://support.google.com/accounts/answer/185833 (app-specific password)
# 
# Common SMTP hosts:
# - SendGrid: smtp.sendgrid.net:587
# - AWS SES: email-smtp.{region}.amazonaws.com:587
# - Gmail: smtp.gmail.com:587
# - Mailgun: smtp.mailgun.org:587
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=<your-sendgrid-api-key>
SMTP_FROM=noreply@yourdomain.com

# Optional: Display name in emails
SMTP_FROM_NAME=Tracker App

# ============================================================================
# TLS/SSL Configuration
# ============================================================================
# If using self-signed or custom CA certificates, set these paths
# Most production setups use Let's Encrypt (automatic)
# NODE_EXTRA_CA_CERTS=/path/to/ca-bundle.crt

# ============================================================================
# Rate Limiting Configuration
# ============================================================================
# All values below are requests per time window.
# These can be tuned per environment without code changes.
# Requires Redis to function.
RATE_LIMIT_WINDOW_SEC=60

# General and feature endpoints (requests per window)
RATE_LIMIT_API_MAX=100
RATE_LIMIT_HABITS_MAX=30
RATE_LIMIT_TODOS_MAX=50
RATE_LIMIT_USERS_MAX=20
RATE_LIMIT_DASHBOARD_MAX=20
RATE_LIMIT_ACHIEVEMENTS_MAX=20

# Auth endpoint limits (requests per window)
RATE_LIMIT_AUTH_REGISTER_MAX=10
RATE_LIMIT_AUTH_LOGIN_MAX=30
RATE_LIMIT_AUTH_VERIFY_MAX=20
RATE_LIMIT_AUTH_FORGOT_MAX=10
RATE_LIMIT_AUTH_RESET_MAX=20

# Tune these based on traffic profile and attack surface.
# Lower auth values for stricter production hardening.

# ============================================================================
# Optional: Error Tracking & Monitoring
# ============================================================================
# Sentry: https://sentry.io/
# New Relic: https://newrelic.com/
# Datadog: https://www.datadoghq.com/
# Splunk: https://www.splunk.com/
SENTRY_DSN=https://your-key@sentry.io/your-project-id
NEW_RELIC_LICENSE_KEY=<your-license-key>
DATADOG_API_KEY=<your-api-key>

# ============================================================================
# Optional: Analytics
# ============================================================================
# Google Analytics
NEXT_PUBLIC_GA_ID=UA-XXXXXXXXX-X

# Mixpanel
NEXT_PUBLIC_MIXPANEL_TOKEN=<your-token>

# ============================================================================
# Logging Configuration
# ============================================================================
# Logs are written to:
# - logs/combined.log: All log levels
# - logs/error.log: Errors only
# - logs/http.log: HTTP requests
# 
# Log retention (in days)
LOG_MAX_FILES=5
LOG_MAX_SIZE=5242880  # 5MB per file (rotating)

# ============================================================================
# Optional: CDN Configuration
# ============================================================================
# For serving static assets from CDN (CloudFlare, Akamai, etc.)
NEXT_PUBLIC_CDN_URL=https://cdn.yourdomain.com

# ============================================================================
# Verification Checklist
# ============================================================================
# Before deploying to production:
# 
# Security:
# ☐ All values filled in (no placeholders)
# ☐ JWT secrets are 32+ random characters
# ☐ COOKIE_SECURE=true
# ☐ DATABASE uses ssl=true
# ☐ REDIS uses rediss:// (TLS enabled)
# ☐ SMTP credentials verified
# ☐ .env file is in .gitignore
# ☐ Secrets stored in secure vault (AWS Secrets Manager, etc.)
# 
# Deployment:
# ☐ MongoDB Atlas configured (encryption, IP whitelist, backups)
# ☐ Redis Cloud configured (persistence, encryption, ACL)
# ☐ SSL/TLS certificate installed (Let's Encrypt or Commercial)
# ☐ Reverse proxy configured (nginx or CloudFlare)
# ☐ Load balancer configured (if multiple instances)
# ☐ Health checks passing
# ☐ Monitoring/alerting configured
# ☐ Rollback procedure documented
# ☐ Database backup procedure verified
# ☐ Log aggregation configured
# 
# ============================================================================
# Support
# ============================================================================
# For MongoDB Atlas issues: https://docs.atlas.mongodb.com/
# For Redis Cloud issues: https://docs.redis.com/
# For SendGrid SMTP: https://sendgrid.com/docs/for-developers/sending-email/
# For Let's Encrypt SSL: https://letsencrypt.org/getting-started/
# ============================================================================
