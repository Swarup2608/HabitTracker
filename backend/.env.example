NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

MONGODB_URI=
REDIS_URL=

JWT_ACCESS_SECRET=replace-with-long-random-string-min-32-chars
JWT_REFRESH_SECRET=replace-with-another-long-random-string-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=14

# For production, set COOKIE_SECURE=true and provide COOKIE_DOMAIN
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Email configuration (for password reset and verification emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@tracker.com

# Optional: Error tracking and monitoring
SENTRY_DSN=
